@model FeedbackPlatform.Web.Models.Applications.ApplicationDetailsViewModel
@{
    ViewData["Title"] = Model.App.Name;
}

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h1>@Model.App.Name</h1>
        @if (!string.IsNullOrEmpty(Model.App.Description))
        {
            <p class="text-muted">@Model.App.Description</p>
        }
    </div>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#curlExampleModal">
        View curl example
    </button>
</div>

@if (Model.NewlyGeneratedKey is not null)
{
    <div class="alert alert-warning">
        <h5>Your new API key</h5>
        <p class="mb-1">Copy it now — for your security, the full key is never shown again.</p>
        <code class="d-block p-2 bg-light border rounded mb-2">@Model.NewlyGeneratedKey.RawKey</code>
        <h6>Try it with curl</h6>
        <pre class="p-2 bg-dark text-light rounded mb-0"><code>@Model.CurlSnippet</code></pre>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>API Keys</span>
        <form asp-action="GenerateApiKey" asp-route-id="@Model.App.Id" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-primary">Generate new key</button>
        </form>
    </div>
    <div class="card-body">
        @if (Model.ApiKeys.Count == 0)
        {
            <p class="mb-0 text-muted">No API keys yet. Generate one to start sending feedback from this application.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Prefix</th>
                        <th>Created</th>
                        <th>Last used</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in Model.ApiKeys)
                    {
                        <tr>
                            <td><code>@key.KeyPrefix&hellip;</code></td>
                            <td>@key.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@(key.LastUsedAtUtc?.ToLocalTime().ToString("g") ?? "never")</td>
                            <td>
                                @if (key.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Revoked</span>
                                }
                            </td>
                            <td>
                                @if (key.IsActive)
                                {
                                    <form asp-action="RevokeApiKey" asp-route-id="@Model.App.Id" asp-route-apiKeyId="@key.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Custom Feedback Fields</div>
    <div class="card-body">
        <p class="text-muted">Add extra fields your feedback form should collect (e.g. "browser", "device_type"). Client apps can fetch this schema from <code>GET /api/v1/feedback/fields</code>.</p>

        @if (Model.CustomFields.Count > 0)
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Label</th>
                        <th>Type</th>
                        <th>Required</th>
                        <th>Order</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var field in Model.CustomFields)
                    {
                        <tr>
                            <td><code>@field.FieldKey</code></td>
                            <td>@field.Label</td>
                            <td>@field.FieldType</td>
                            <td>@(field.IsRequired ? "Yes" : "No")</td>
                            <td>@field.DisplayOrder</td>
                            <td>
                                <form asp-action="DeleteCustomField" asp-route-id="@Model.App.Id" asp-route-fieldId="@field.Id" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <hr />
        <h6>Add fields</h6>
        <form asp-action="AddCustomField" asp-route-id="@Model.App.Id" method="post" id="add-fields-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="field-rows">
                @for (var i = 0; i < Model.NewCustomFields.Count; i++)
                {
                    var rowViewData = new ViewDataDictionary(ViewData) { ["Index"] = i };
                    <partial name="_CustomFieldRow" model="Model.NewCustomFields[i]" view-data="rowViewData" />
                }
            </div>
            <button type="button" id="add-row-btn" class="btn btn-outline-secondary btn-sm mb-3">+ Add another field</button>
            <div>
                <button type="submit" class="btn btn-primary">Save fields</button>
            </div>
        </form>
    </div>
</div>

<a asp-controller="Feedback" asp-action="Index" asp-route-appId="@Model.App.Id" class="btn btn-outline-secondary">View feedback for this app</a>

<div class="modal fade" id="curlExampleModal" tabindex="-1" aria-labelledby="curlExampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="curlExampleModalLabel">curl example for @Model.App.Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model.NewlyGeneratedKey is null)
                {
                    <p class="text-muted">
                        This example uses a placeholder for the API key. Generate a key above to get one with your real key filled in.
                    </p>
                }
                <pre class="p-2 bg-dark text-light rounded mb-0"><code id="curlExampleText">@Model.GeneralCurlSnippet</code></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="copyCurlBtn">Copy</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rowsContainer = document.getElementById('field-rows');
            const addBtn = document.getElementById('add-row-btn');
            const form = document.getElementById('add-fields-form');
            let nextIndex = @Model.NewCustomFields.Count;

            const fieldTypeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Html.GetEnumSelectList<FeedbackPlatform.Domain.Enums.FeedbackFieldType>()
                    .Select(o => new { value = o.Value, text = o.Text })));

            function createRow(index) {
                const wrapper = document.createElement('div');
                wrapper.innerHTML = buildRowHtml(index);
                return wrapper.firstElementChild;
            }

            function buildRowHtml(index) {
                const options = fieldTypeOptions.map(o => `<option value="${o.value}">${o.text}</option>`).join('');
                return `
                    <div class="row g-2 mb-2 field-row align-items-end">
                        <div class="col-md-2">
                            <label class="form-label">Field key</label>
                            <input name="NewCustomFields[${index}].FieldKey" class="form-control" placeholder="browser_name" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Label</label>
                            <input name="NewCustomFields[${index}].Label" class="form-control" placeholder="Browser Name" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Type</label>
                            <select name="NewCustomFields[${index}].FieldType" class="form-select">${options}</select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Options (CSV)</label>
                            <input name="NewCustomFields[${index}].OptionsCsv" class="form-control" placeholder="Chrome,Firefox,Safari" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Order</label>
                            <input name="NewCustomFields[${index}].DisplayOrder" type="number" class="form-control" value="0" />
                        </div>
                        <div class="col-md-1">
                            <div class="form-check">
                                <input name="NewCustomFields[${index}].IsRequired" type="checkbox" class="form-check-input" value="true" />
                                <label class="form-check-label">Req'd</label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-row-btn">Remove</button>
                        </div>
                    </div>`;
            }

            addBtn.addEventListener('click', function () {
                rowsContainer.appendChild(createRow(nextIndex));
                nextIndex++;
            });

            rowsContainer.addEventListener('click', function (e) {
                if (!e.target.classList.contains('remove-row-btn')) {
                    return;
                }
                const row = e.target.closest('.field-row');
                if (rowsContainer.querySelectorAll('.field-row').length > 1) {
                    row.remove();
                } else {
                    row.querySelectorAll('input').forEach(function (input) {
                        if (input.type === 'checkbox') { input.checked = false; } else { input.value = ''; }
                    });
                }
            });

            // Rows can be added/removed in any order client-side, which can leave gaps in the
            // NewCustomFields[i] indices; ASP.NET Core's default collection binder stops at the
            // first missing index, so renumber every row sequentially right before submitting.
            form.addEventListener('submit', function () {
                const rows = rowsContainer.querySelectorAll('.field-row');
                rows.forEach(function (row, idx) {
                    row.querySelectorAll('[name]').forEach(function (input) {
                        input.name = input.name.replace(/NewCustomFields\[\d+\]/, `NewCustomFields[${idx}]`);
                    });
                });
            });

            const copyBtn = document.getElementById('copyCurlBtn');
            copyBtn.addEventListener('click', function () {
                const text = document.getElementById('curlExampleText').textContent;
                navigator.clipboard.writeText(text).then(function () {
                    const original = copyBtn.textContent;
                    copyBtn.textContent = 'Copied!';
                    setTimeout(function () { copyBtn.textContent = original; }, 1500);
                });
            });

            @if (TempData["ShowCurlModal"] != null)
            {
                <text>
                // The page was just reloaded after saving custom field(s); the curl example above
                // already reflects them (fetched fresh from the server), so pop it open automatically
                // instead of making the user click "View curl example" again.
                new bootstrap.Modal(document.getElementById('curlExampleModal')).show();
                </text>
            }
        })();
    </script>
}
