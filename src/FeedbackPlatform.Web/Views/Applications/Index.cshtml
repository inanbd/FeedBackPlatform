@model IReadOnlyList<FeedbackPlatform.Application.Features.FeedbackApps.Queries.FeedbackAppDto>
@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>My Applications</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Application</a>
</div>

@if (Model.Count == 0)
{
    <p class="mt-3">You haven't registered any applications yet. Create one to get an API key for collecting feedback.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>@app.Name</td>
                    <td>@app.Description</td>
                    <td>@app.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td><a asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-primary">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
}
